# ---- Database (PostgreSQL / Supabase) ----
# Supabase: use the "Session pooler" connection string (port 5432) so it works
# for migrations. Local Postgres example:
#   postgresql://postgres:postgres@localhost:5432/ecomate
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---- Auth ----
# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
# Optional: override the session cookie name (defaults to "ecomate_session")
SESSION_COOKIE_NAME="ecomate_session"

# ---- News feed (optional, for /Feed) ----
NEWSAPI_KEY=""
GNEWS_API_KEY=""

# ---- Company (CAC) verification (optional, future integration) ----
# Leave disabled to validate registration numbers for uniqueness only.
# CAC_VERIFICATION_ENABLED="true"
# CAC_PROVIDER="dojah"
# CAC_PROVIDER_API_KEY=""
# CAC_PROVIDER_APP_ID=""
