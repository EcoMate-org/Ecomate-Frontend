generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  NGO
  COMPANY
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum MaterialType {
  PLASTIC
  METAL
  E_WASTE
  GLASS
  RUBBER
}

enum ItemStatus {
  AVAILABLE
  RESERVED
  SOLD
  REMOVED
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
}

enum ArtworkSaleType {
  FIXED_PRICE
  AUCTION
}

enum AuctionStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum ChallengeStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum NotificationType {
  BID_RECEIVED
  BID_ACCEPTED
  MESSAGE_RECEIVED
  CHALLENGE_INVITE
  ORDER_COMPLETED
}

// ─── Add these two enums after ChallengeStatus ──────────────────────────────

enum ChallengeType {
  QUANTITY
  ACTION
  COMMUNITY
}

enum RewardType {
  NONE
  BADGE
  CERTIFICATE
  CASH
  VOUCHER
}
// ─── New enums ──────────────────────────────────────────────

enum PostType {
  MOMENT
  CHALLENGE_ANNOUNCEMENT
  LISTING
}

enum LikeTargetType {
  POST
  ARTWORK
  ITEM
}

enum GoalType {
  PRESET
  CUSTOM
}

enum GoalPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum SubmissionStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

// ─── New models ─────────────────────────────────────────────
model Goal {
  id           String      @id @default(cuid())
  userId       String
  title        String
  type         GoalType    @default(CUSTOM)
  targetValue  Int         @default(1)
  currentValue Int         @default(0)
  unit         String?     // "bottles", "bags", "kg", "days"
  period       GoalPeriod  @default(WEEKLY)
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ChallengeSubmission {
  id            String           @id @default(cuid())
  challengeId   String
  userId        String
  description   String
  notes         String?
  proofImageUrl String?          // MVP: URL paste; future: Supabase upload
  status        SubmissionStatus @default(SUBMITTED)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id])
  user      User      @relation(fields: [userId],      references: [id])

  @@index([challengeId])
  @@index([userId])
}

model Like {
  id String @id @default(cuid())

  userId     String
  targetType LikeTargetType
  targetId   String

  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  post   Post?   @relation(fields: [postId], references: [id])
  postId String?

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model Bookmark {
  id String @id @default(cuid())

  userId String
  postId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
  @@index([postId])
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id String @id @default(cuid())

  userId String

  purpose AuthTokenPurpose

  /// SHA-256 hex digest of the raw token sent in the email link.
  /// The raw token itself is never persisted.
  tokenHash String @unique

  expiresAt DateTime

  usedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, purpose])
}

model Post {
  id String @id @default(cuid())

  authorId String

  type PostType @default(MOMENT)

  text String

  imageUrl String?

  location String?

  // Only set when type = LISTING or CHALLENGE_ANNOUNCEMENT,
  // linking the post to the underlying record it announces.
  itemId      String?
  artworkId   String?
  challengeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User       @relation(fields: [authorId], references: [id])
  item      Item?      @relation(fields: [itemId], references: [id])
  artwork   Artwork?   @relation(fields: [artworkId], references: [id])
  challenge Challenge? @relation(fields: [challengeId], references: [id])
 

  likes     Like[]
  comments  Comment[]
  bookmarks Bookmark[]

  @@index([authorId])
  @@index([type])
  @@index([createdAt])

  
}

model Comment {
  id String @id @default(cuid())

  postId   String
  authorId String

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   Post @relation(fields: [postId], references: [id])
  author User @relation(fields: [authorId], references: [id])

  @@index([postId])
}

model User {
  id String @id @default(cuid())

  firstName String?
  lastName  String?

  companyName    String?
  companyAddress String?

  username     String @unique
  email        String @unique
  passwordHash String

  registrationNumber String? @unique

  bio       String?
  imageFile String?

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  isVerified Boolean @default(false)
  emailVerifiedAt DateTime?
  authTokens      AuthToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goals                Goal[]
  challengeSubmissions ChallengeSubmission[]
  items         Item[]
  artworks      Artwork[]
  notifications Notification[]

  scanHistory ScanHistory[]

  artworkBids ArtworkBid[]

  sentMessages Message[]

  buyerOrders  Order[] @relation("BuyerOrders")
  sellerOrders Order[] @relation("SellerOrders")

  challengeParticipations ChallengeParticipant[]

  wonAuctions ArtworkAuction[] @relation("AuctionWinner")

  createdChallenges Challenge[] @relation("ChallengeCreator")
  posts             Post[]
  likes             Like[]
  comments          Comment[]
  bookmarks         Bookmark[]
}

model Item {
  id String @id @default(cuid())

  userId String

  title       String
  description String?

  materialType MaterialType

  quantity Int

  pricePerQuantity Decimal @db.Decimal(10, 2)

  status ItemStatus @default(AVAILABLE)

  location String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  images Image[]

  orders Order[]
  posts  Post[]

  @@index([userId])
  @@index([materialType])
  @@index([status])
}

model Image {
  id String @id @default(cuid())

  imageUrl String

  artworkId String?
  itemId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artwork Artwork? @relation(fields: [artworkId], references: [id])
  item    Item?    @relation(fields: [itemId], references: [id])

  @@index([artworkId])
  @@index([itemId])
}

model Artwork {
  id String @id @default(cuid())

  userId String

  title String

  description String?

  fixedPrice Decimal? @db.Decimal(10, 2)

  estimatedPrice Decimal @db.Decimal(10, 2)

  quantity Int

  isAvailable Boolean @default(true)

  saleType ArtworkSaleType @default(FIXED_PRICE)
  location String?
  

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  orders Order[]
  images Image[]
  posts  Post[]

  auction ArtworkAuction?

  @@index([userId])
}

model ArtworkAuction {
  id String @id @default(cuid())

  artworkId String @unique

  startingBid Decimal @db.Decimal(10, 2)

  currentHighestBid Decimal? @db.Decimal(10, 2)

  minimumIncrement Decimal @default(5) @db.Decimal(10, 2)

  startTime DateTime
  endTime   DateTime

  status AuctionStatus @default(ACTIVE)

  winnerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artwork Artwork @relation(fields: [artworkId], references: [id])

  winner User? @relation("AuctionWinner", fields: [winnerId], references: [id])

  bids ArtworkBid[]
}

model ArtworkBid {
  id String @id @default(cuid())

  auctionId String
  bidderId  String

  amount Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auction ArtworkAuction @relation(fields: [auctionId], references: [id])

  bidder User @relation(fields: [bidderId], references: [id])

  @@index([auctionId])
  @@index([bidderId])
}

model Order {
  id String @id @default(cuid())

  itemId String?
  artworkId String?

  buyerId  String
  sellerId String

  totalAmount Decimal @db.Decimal(10, 2)

  status OrderStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item Item? @relation(fields: [itemId], references: [id])
  artwork Artwork? @relation(fields: [artworkId], references: [id])

  buyer User @relation("BuyerOrders", fields: [buyerId], references: [id])

  seller User @relation("SellerOrders", fields: [sellerId], references: [id])
  
  @@index([buyerId])
  @@index([sellerId])
  @@index([itemId])
  @@index([artworkId])
}

model ScanHistory {
  id String @id @default(cuid())

  userId String

  imageUrl String

  predictedMaterial MaterialType?      // ← now nullable, artwork scans have none
  confidenceScore   Float?             // ← new

  qualityScore   Int
  estimatedPrice Decimal @db.Decimal(10, 2)

  summary   String?
  isArtwork Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Challenge {
  id String @id @default(cuid())

  creatorId String

  title String

  description String

  reward String

  deadline DateTime
  type        ChallengeType @default(COMMUNITY)
  rewardType  RewardType    @default(NONE)
  targetValue Int?         
  unit        String?       
  imageUrl    String?

  status ChallengeStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator User @relation("ChallengeCreator", fields: [creatorId], references: [id])
  submissions ChallengeSubmission[]
  participants ChallengeParticipant[]
  posts        Post[]
}

model ChallengeParticipant {
  id String @id @default(cuid())

  userId      String
  challengeId String

  progress Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@unique([userId, challengeId])
}

model Conversation {
  id String @id @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id String @id @default(cuid())

  conversationId String
  userId         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id String @id @default(cuid())

  conversationId String

  senderId String

  content String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id])

  sender User @relation(fields: [senderId], references: [id])

  @@index([conversationId])
}

model Notification {
  id String @id @default(cuid())

  userId String

  title String

  message String

  type NotificationType

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}
