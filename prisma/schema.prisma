generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(cuid())
  username     String @unique
  email        String @unique
  passwordHash String

  // Individual (USER role) profile fields
  firstName String?
  lastName  String?

  // Organisation (NGO / COMPANY role) profile fields
  companyName        String?
  registrationNumber String? @unique
  companyAddress     String?

  bio        String?
  imageFile  String?
  role       UserRole   @default(USER)
  status     UserStatus @default(ACTIVE)
  isVerified Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  Artwork                    Artwork[]
  ArtworkAuction             ArtworkAuction[]
  ArtworkBid                 ArtworkBid[]
  Challenge                  Challenge[]
  ChallengeParticipant       ChallengeParticipant[]
  Item                       Item[]
  Message                    Message[]
  Notification               Notification[]
  Order_Order_buyerIdToUser  Order[]                @relation("Order_buyerIdToUser")
  Order_Order_sellerIdToUser Order[]                @relation("Order_sellerIdToUser")
  ScanHistory                ScanHistory[]
}

model Artwork {
  id             String          @id
  userId         String
  title          String
  description    String?
  fixedPrice     Decimal?        @db.Decimal(10, 2)
  estimatedPrice Decimal         @db.Decimal(10, 2)
  quantity       Int
  isAvailable    Boolean         @default(true)
  saleType       ArtworkSaleType @default(FIXED_PRICE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  User           User            @relation(fields: [userId], references: [id])
  ArtworkAuction ArtworkAuction?
  Image          Image[]

  @@index([userId])
}

model ArtworkAuction {
  id                String        @id
  artworkId         String        @unique
  startingBid       Decimal       @db.Decimal(10, 2)
  currentHighestBid Decimal?      @db.Decimal(10, 2)
  minimumIncrement  Decimal       @default(5) @db.Decimal(10, 2)
  startTime         DateTime
  endTime           DateTime
  status            AuctionStatus @default(ACTIVE)
  winnerId          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime
  Artwork           Artwork       @relation(fields: [artworkId], references: [id])
  User              User?         @relation(fields: [winnerId], references: [id])
  ArtworkBid        ArtworkBid[]
}

model ArtworkBid {
  id             String         @id
  auctionId      String
  bidderId       String
  amount         Decimal        @db.Decimal(10, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  ArtworkAuction ArtworkAuction @relation(fields: [auctionId], references: [id])
  User           User           @relation(fields: [bidderId], references: [id])

  @@index([auctionId])
  @@index([bidderId])
}

model Challenge {
  id                   String                 @id
  creatorId            String
  title                String
  description          String
  reward               String
  deadline             DateTime
  status               ChallengeStatus        @default(ACTIVE)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  User                 User                   @relation(fields: [creatorId], references: [id])
  ChallengeParticipant ChallengeParticipant[]
}

model ChallengeParticipant {
  id          String    @id
  userId      String
  challengeId String
  progress    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Challenge   Challenge @relation(fields: [challengeId], references: [id])
  User        User      @relation(fields: [userId], references: [id])

  @@unique([userId, challengeId])
}

model Conversation {
  id                      String                    @id
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  ConversationParticipant ConversationParticipant[]
  Message                 Message[]
}

model ConversationParticipant {
  id             String       @id
  conversationId String
  userId         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@unique([conversationId, userId])
}

model Image {
  id        String   @id
  imageUrl  String
  artworkId String?
  itemId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  Artwork   Artwork? @relation(fields: [artworkId], references: [id])
  Item      Item?    @relation(fields: [itemId], references: [id])

  @@index([artworkId])
  @@index([itemId])
}

model Item {
  id               String       @id
  userId           String
  title            String
  description      String?
  materialType     MaterialType
  quantity         Int
  pricePerQuantity Decimal      @db.Decimal(10, 2)
  status           ItemStatus   @default(AVAILABLE)
  location         String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime
  Image            Image[]
  User             User         @relation(fields: [userId], references: [id])
  Order            Order[]

  @@index([materialType])
  @@index([status])
  @@index([userId])
}

model Message {
  id             String       @id
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime
  Conversation   Conversation @relation(fields: [conversationId], references: [id])
  User           User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
}

model Notification {
  id        String           @id
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime
  User      User             @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Order {
  id                        String      @id
  itemId                    String
  buyerId                   String
  sellerId                  String
  totalAmount               Decimal     @db.Decimal(10, 2)
  status                    OrderStatus @default(PENDING)
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime
  User_Order_buyerIdToUser  User        @relation("Order_buyerIdToUser", fields: [buyerId], references: [id])
  Item                      Item        @relation(fields: [itemId], references: [id])
  User_Order_sellerIdToUser User        @relation("Order_sellerIdToUser", fields: [sellerId], references: [id])

  @@index([buyerId])
  @@index([sellerId])
}

model ScanHistory {
  id                String       @id
  userId            String
  imageUrl          String
  predictedMaterial MaterialType
  confidenceScore   Float
  createdAt         DateTime     @default(now())
  updatedAt         DateTime
  User              User         @relation(fields: [userId], references: [id])
}

enum UserRole {
  USER
  NGO
  COMPANY
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ArtworkSaleType {
  FIXED_PRICE
  AUCTION
}

enum AuctionStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum ChallengeStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum ItemStatus {
  AVAILABLE
  RESERVED
  SOLD
  REMOVED
}

enum MaterialType {
  PLASTIC
  METAL
  E_WASTE
  GLASS
  RUBBER
}

enum NotificationType {
  BID_RECEIVED
  BID_ACCEPTED
  MESSAGE_RECEIVED
  CHALLENGE_INVITE
  ORDER_COMPLETED
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
}
